# Copy to .env.local. Values here are placeholders, never commit real secrets.
SESSION_SECRET=change-me-to-a-long-random-string-of-32+chars
# Optional: enables the real vision-model POD check. Without it the app uses the clearly-labelled mock extractor.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Optional storage overrides (defaults to ./data)
DATABASE_PATH=
UPLOAD_DIR=
# Set to false to disable first-run demo seeding
AUTO_SEED=true
